const crypto = require('crypto');

function base64url(input) {
  const buf = Buffer.isBuffer(input) ? input : Buffer.from(input);
  return buf.toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

function normalizePrivateKey(raw) {
  let key = raw;
  if (key.startsWith('"') && key.endsWith('"')) {
    key = key.slice(1, -1);
  }
  key = key.replace(/\\n/g, '\n');
  return key;
}

async function getAccessToken() {
  const { GOOGLE_CLIENT_EMAIL, GOOGLE_PRIVATE_KEY } = process.env;

  const header = { alg: 'RS256', typ: 'JWT' };
  const now = Math.floor(Date.now() / 1000) - 10; // невеликий запас на розсинхрон часу
  const claims = {
    iss: GOOGLE_CLIENT_EMAIL,
    scope: 'https://www.googleapis.com/auth/calendar.events',
    aud: 'https://oauth2.googleapis.com/token',
    iat: now,
    exp: now + 3600,
  };

  const unsigned = `${base64url(JSON.stringify(header))}.${base64url(JSON.stringify(claims))}`;
  const privateKey = normalizePrivateKey(GOOGLE_PRIVATE_KEY);
  const signature = crypto.sign('RSA-SHA256', Buffer.from(unsigned), privateKey);
  const jwt = `${unsigned}.${base64url(signature)}`;

  const res = await fetch('https://oauth2.googleapis.com/token', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams({
      grant_type: 'urn:ietf:params:oauth:grant-type:jwt-bearer',
      assertion: jwt,
    }),
  });

  const data = await res.json();
  if (!data.access_token) {
    throw new Error('Google OAuth помилка: ' + JSON.stringify(data));
  }
  return data.access_token;
}

async function createCalendarEvent({ summary, description, startDate, endDate }) {
  const { GOOGLE_CALENDAR_ID } = process.env;

  const accessToken = await getAccessToken();

  const endExclusive = new Date(endDate);
  endExclusive.setDate(endExclusive.getDate() + 1);
  const endExclusiveStr = endExclusive.toISOString().slice(0, 10);

  const res = await fetch(
    `https://www.googleapis.com/calendar/v3/calendars/${encodeURIComponent(GOOGLE_CALENDAR_ID)}/events`,
    {
      method: 'POST',
      headers: {
        Authorization: `Bearer ${accessToken}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        summary,
        description,
        start: { date: startDate },
        end: { date: endExclusiveStr },
      }),
    }
  );

  const data = await res.json();
  if (!res.ok) {
    const err = new Error('Google Calendar API помилка: ' + JSON.stringify(data));
    err.httpStatus = res.status;
    err.googleResponse = data;
    throw err;
  }

  return data;
}

exports.handler = async () => {
  const envStatus = {
    GOOGLE_CLIENT_EMAIL: process.env.GOOGLE_CLIENT_EMAIL || 'ВІДСУТНЯ',
    GOOGLE_PRIVATE_KEY_present: !!process.env.GOOGLE_PRIVATE_KEY,
    GOOGLE_PRIVATE_KEY_length: process.env.GOOGLE_PRIVATE_KEY ? process.env.GOOGLE_PRIVATE_KEY.length : 0,
    GOOGLE_PRIVATE_KEY_starts_with: process.env.GOOGLE_PRIVATE_KEY ? process.env.GOOGLE_PRIVATE_KEY.slice(0, 35) : null,
    GOOGLE_CALENDAR_ID: process.env.GOOGLE_CALENDAR_ID || 'ВІДСУТНЯ',
  };

  try {
    const event = await createCalendarEvent({
      summary: '🧪 ТЕСТОВА ПОДІЯ (можна видалити) V1.0.2',
      description: 'Діагностична подія від test-calendar.js',
      startDate: '2026-08-25',
      endDate: '2026-08-26',
    });

    return {
      statusCode: 200,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ success: true, event, envStatus }, null, 2),
    };
  } catch (err) {
    return {
      statusCode: 200, // навмисно 200, щоб браузер завжди показав body без "Network Error"
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(
        {
          success: false,
          errorMessage: String(err.message || err),
          httpStatus: err.httpStatus || null,
          googleResponse: err.googleResponse || null,
          stack: err.stack,
          envStatus,
        },
        null,
        2
      ),
    };
  }
};
